{
  "name": "@cedarling-tutorials/identity-provider",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx watch src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "setup": "node ../host check && node scripts/setup.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "5.2.1",
    "jose": "6.2.10",
    "oidc-provider": "9.11.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/oidc-provider": "9.11.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
