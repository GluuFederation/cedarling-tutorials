{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "moduleResolution": "Bundler",
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "src/shared/**/*.ts",
    "test/**/*.tsx"
  ]
}
