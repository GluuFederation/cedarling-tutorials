{
  "name": "@cedarling-tutorials/p11-saas-workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "admin": "node scripts/admin.ts",
    "build": "react-router build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "node scripts/dev.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "setup": "node ../shared/host check && node scripts/setup.ts",
    "test:e2e": "node scripts/verify-docker.ts",
    "preflight": "node scripts/preflight.mjs",
    "reset": "node --env-file=.env scripts/reset.ts",
    "start": "pnpm preflight && node --env-file=.env server.js",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc -b --pretty false"
  },
  "dependencies": {
    "@react-router/express": "8.4.0",
    "@react-router/node": "8.4.0",
    "express": "5.2.1",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
