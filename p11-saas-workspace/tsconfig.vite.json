{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "server/**/*",
    "src/server/**/*",
    "src/shared/**/*",
    "src/web/icons.tsx",
    "test/**/*"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "~/*": ["./app/*"] },
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "target": "ES2023",
    "types": ["node", "vite/client"]
  }
}
