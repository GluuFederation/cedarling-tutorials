{
  "extends": "./tsconfig.json",
  "include": [
    "server/index.js",
    "scripts/**/*.ts",
    "server/**/*.ts",
    "app/types/**/*",
    "vite.config.ts",
    "react-router.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["server/app.ts"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "types": ["node"]
  }
}
