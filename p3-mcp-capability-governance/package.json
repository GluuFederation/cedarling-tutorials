{
  "name": "@cedarling-tutorials/p3-mcp-capability-governance",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "node ../shared/policy-store.mjs && tsc -p tsconfig.build.json",
    "chat": "tsx scripts/chat.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "docker compose up --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "setup": "node scripts/setup.mjs",
    "start": "docker compose up",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "5.2.1",
    "hono": "4.13.7",
    "jose": "6.2.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cedar-policy/cedar-wasm": "4.12.0",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "fflate": "0.8.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
